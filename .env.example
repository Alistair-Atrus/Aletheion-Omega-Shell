# Copy this file to .env and fill in your real values.
# Never commit .env, never paste tokens into chat or code.
# Discord-only version — no Stoat.

# --- Bot ---
DISCORD_BOT_TOKEN=

# --- AI: local first, cloud fallback ---
# AnythingLLM local (Qwen3-8B, workspace Cybermancy) is tried first.
# Get the key in AnythingLLM: Settings > Developer API > Copy API Key.
# Workspace slug is the lowercase name, e.g. cybermancy.
ANYTHINGLLM_URL=http://localhost:3001
ANYTHINGLLM_API_KEY=
ANYTHINGLLM_WORKSPACE=cybermancy

# Cloud fallback (optional — leave blank for local-only).
# Claude is tried second, Gemini third.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Image generation (optional, only for ?dream / ?sigil) ---
STABILITY_HOST=
STABILITY_MODEL_ID=

# --- Access control ---
# Your Discord user ID (Discord Settings > Advanced > Developer Mode on,
# then right-click your name > Copy User ID). Comma-separated if several.
# Admins can run glyph/lore management, reload, status, and shutdown.
# Everyone else can run all other commands.
BOT_ADMIN_IDS=

# --- AnythingLLM threads (per-Discord-user, default on) ---
# 1 = each Discord user gets their own thread in the workspace.
# 0 = use only the OpenAI-compatible endpoint (one shared thread).
ANYTHINGLLM_THREADS=1

# --- Startup announcement (optional) ---
# When the bot comes online it posts a wake-up message to this channel,
# pinging this role. Create the role in Discord first (Server Settings >
# Roles), turn on "Allow anyone to @mention this role" in the role's
# settings, then copy the IDs (Developer Mode on, right-click > Copy ID).
# Leave ANNOUNCE_CHANNEL_ID blank to disable the announcement.
# Test it any time with ?announce (admin only).
ANNOUNCE_CHANNEL_ID=
ANNOUNCE_ROLE_ID=
# ANNOUNCE_MESSAGE=Aletheion Ω-Shell is awake. The Glyphic Cybermancy System is online.
